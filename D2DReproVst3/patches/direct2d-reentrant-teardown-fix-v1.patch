+    /*  adapterCreated()/adapterRemoved() (below) call teardown() whenever this context's
+        current adapter is being replaced -- normally safe, since DxgiAdapters only fires those
+        from DxgiAdapters::updateAdapters()/releaseAdapters(), which only run on the message
+        thread via VBlankDispatcher::reconfigureDisplays() <- ComponentPeer::doSettingChange().
+
+        But WM_DISPLAYCHANGE/WM_SETTINGCHANGE are delivered with SendMessage, not PostMessage --
+        a *sent* message. If this thread is blocked inside a call that synchronises with the
+        DWM (IDXGISwapChain::ResizeBuffers, IDXGISwapChain1::Present1,
+        IDCompositionDevice::Commit -- all reachable from a single paint cycle in
+        Direct2DHwndContext::HwndPimpl), Windows can deliver that sent message reentrantly, on
+        this same thread, nested inside the call that's still using this object's Direct2D/DXGI
+        members. Running teardown() at that point would null out members (device context, swap
+        chain buffer) the interrupted outer call is still holding and about to dereference --
+        e.g. SwapChain::resize() calling chain->GetDevice() right after chain was reset to
+        nullptr underneath it, or Pimpl::finishFrame() re-fetching a now-null device context
+        before calling EndDraw().
+
+        enterReentrancyGuard()/leaveReentrancyGuard() bracket the vulnerable spans (see
+        HwndPimpl). While the guard is held, adapterCreated()/adapterRemoved() below defer the
+        actual teardown() until the guard is released, at which point the frame has either
+        finished or been abandoned and it's safe to tear everything down for real. This is a
+        no-op for any Pimpl subclass that never calls enterReentrancyGuard() -- the counter
+        stays zero, so adapterCreated()/adapterRemoved() run exactly as before.
+    */
+    void enterReentrancyGuard() noexcept
+    {
+        ++reentrancyGuardCount;
+    }
+
+    void leaveReentrancyGuard()
+    {
+        jassert (reentrancyGuardCount > 0);
+
+        if (--reentrancyGuardCount == 0 && teardownDeferred)
+        {
+            teardownDeferred = false;
+            teardown();
+        }
+    }
