+    // create() above returns its local `result` by value (into the std::optional) and then
+    // lets that local run off the end of the function -- normally harmless, but now that
+    // ~CompositionTree() actually does something (see below), a COPY here would leave both the
+    // returned object and the about-to-be-destroyed local pointing at the *same* underlying
+    // IDCompositionVisual/Target/Device, and the local's destructor would immediately detach
+    // the content and commit an empty tree onto the copy we just returned -- silently undoing
+    // the composition we just finished setting up. ComSmartPtr (juce_ComSmartPtr_windows.h) has
+    // no move constructor of its own, only copy, so this needs a hand-written move that
+    // actually transfers ownership (leaving the moved-from side null) rather than letting the
+    // compiler fall back to copying each member. Deleting the copy operations means any future
+    // accidental copy is a compile error instead of this exact silent bug.
+    CompositionTree (CompositionTree&& other)
+    {
+        std::swap (compositionDevice, other.compositionDevice);
+        std::swap (compositionTarget, other.compositionTarget);
+        std::swap (compositionVisual, other.compositionVisual);
+    }
+
+    CompositionTree& operator= (CompositionTree&& other)
+    {
+        std::swap (compositionDevice, other.compositionDevice);
+        std::swap (compositionTarget, other.compositionTarget);
+        std::swap (compositionVisual, other.compositionVisual);
+        return *this;
+    }
+
+    CompositionTree (const CompositionTree&) = delete;
+    CompositionTree& operator= (const CompositionTree&) = delete;
+
+    // CreateTargetForHwnd's target isn't purely an app-side object -- it's tied to the window
+    // at the OS/compositor level (the call is serviced in the kernel-mode component associated
+    // with the DWM), so the compositor can keep showing the last frame this visual was told to
+    // display even after every COM reference this process holds is simply released. Confirmed
+    // by direct report: after a monitor unplug/reshuffle, a window-shaped outline sometimes
+    // remained on screen even after the host DAW had been closed entirely -- clearing only once
+    // Windows itself restarted (i.e. once the DWM's own state reset), not when the owning
+    // process exited. Explicitly detach the content and commit the now-empty tree before
+    // releasing our references, so the DWM is actually told to stop compositing this visual
+    // rather than relying on reference-counting to imply it. Safe to do here even when this
+    // runs as part of a deferred teardown() (see Pimpl::leaveReentrancyGuard()) -- by the time
+    // that runs, the vulnerable reentrant window has already closed, so these calls are no
+    // longer at risk of being interrupted by the same nested-message-pump problem that
+    // motivated the reentrancy guard in the first place.
+    ~CompositionTree()
+    {
+        if (compositionVisual != nullptr)
+        {
+            const auto hr = compositionVisual->SetContent (nullptr);
+            jassertquiet (SUCCEEDED (hr));
+        }
+
+        if (compositionTarget != nullptr)
+        {
+            const auto hr = compositionTarget->SetRoot (nullptr);
+            jassertquiet (SUCCEEDED (hr));
+        }
+
+        if (compositionDevice != nullptr)
+        {
+            const auto hr = compositionDevice->Commit();
+            jassertquiet (SUCCEEDED (hr));
+        }
+    }
+
 private:
     CompositionTree() = default;
 
