             return;
         }
 
-        if (hr == S_OK)
-            swap.didPresent();
+        // hr is a success code here (FAILED already returned above). That includes
+        // DXGI_STATUS_OCCLUDED and similar non-S_OK success codes, which Present1 returns
+        // while the window is occluded -- e.g. behind the lock screen or screensaver.
+        // DXGI still accepted the frame in that case, so the throttle should still reset;
+        // checking hr == S_OK specifically left didWait stuck true for the whole occluded
+        // period (canPresent() short-circuits without waiting), silently re-opening the
+        // original un-throttled race once the session unlocked, until the editor was
+        // closed and reopened and rebuilt the swap chain from scratch.
+        swap.didPresent();
 
         // There's nothing waiting to be displayed in the backbuffer.
         deferredRepaints.clear();
