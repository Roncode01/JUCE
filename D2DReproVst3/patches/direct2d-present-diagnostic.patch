+// ============================================================================
+// DIAGNOSTIC LOGGING (temporary -- not part of any real fix)
+//
+// Added to find out which actual HRESULT Present1() returns during screensaver,
+// lock-screen, hibernate, sleep and display-off transitions, rather than
+// continuing to guess (prior analysis assumed DXGI_STATUS_OCCLUDED, but
+// Microsoft's own docs say that code is never returned for a flip-model swap
+// chain, which is what this file creates -- so the real code is currently
+// unknown). Purely observational: does not change canPresent()/didPresent() or
+// any control flow. Logs every time either probe's returned HRESULT changes,
+// with a timestamp and how long the previous value held, to
+// %TEMP%\d2d_present_diagnostic.log (and mirrored to OutputDebugStringA for
+// anyone watching with a debugger/DebugView attached).
+//
+// Two probes are logged, independently, under their own labels:
+//   - "Present1 normal": the real present this file already makes (submits the painted
+//     frame). Its result and flags are unchanged from before -- this is the call that actually
+//     drives rendering.
+//   - "Present1 test": a SECOND call, added 2026-10-11, made immediately after the real one on
+//     every paint, using DXGI_PRESENT_TEST (0 sync interval, no frame submitted -- Microsoft's
+//     own documented way to check presentability without presenting:
+//     https://learn.microsoft.com/en-us/windows/win32/api/dxgi/nf-dxgi-idxgiswapchain-present).
+//     Its result is logged and otherwise discarded -- nothing downstream reacts to it -- so it
+//     cannot change behaviour, only add a second, independent data point for whatever is
+//     happening to presentability at the same moment. This matters because no fix in this
+//     project currently calls DXGI_PRESENT_TEST at all (an earlier "occlusion-standby" design
+//     that would have was deliberately kept out of this diagnostic build), so without this
+//     second probe there would be nothing here to show what a test-present reports during an
+//     occluded/transitioning period.
+//
+// Remove this whole block, and its two call sites in Pimpl::paint() below, once real values
+// have been captured.
+#include <cstdio>
+#include <cstdint>
+#include <chrono>
+
+namespace Direct2DPresentDiagnostic
+{
+    inline const char* decodeHresult (HRESULT hr) noexcept
+    {
+        switch ((unsigned long) hr)
+        {
+            case 0x00000000UL: return "S_OK";
+            case 0x087A0001UL: return "DXGI_STATUS_OCCLUDED (not expected -- flip model)";
+            case 0x087A0007UL: return "DXGI_STATUS_MODE_CHANGED";
+            case 0x087A0008UL: return "DXGI_STATUS_MODE_CHANGE_IN_PROGRESS";
+            case 0x887A0001UL: return "DXGI_ERROR_INVALID_CALL";
+            case 0x887A0005UL: return "DXGI_ERROR_DEVICE_REMOVED";
+            case 0x887A0006UL: return "DXGI_ERROR_DEVICE_HUNG";
+            case 0x887A0007UL: return "DXGI_ERROR_DEVICE_RESET";
+            case 0x887A0026UL: return "DXGI_ERROR_ACCESS_LOST";
+            default:           return "unrecognised -- look up this hex value";
+        }
+    }
+
+    inline void logLine (const char* text) noexcept
+    {
+        OutputDebugStringA (text);
+
+        char tempPath[MAX_PATH]{};
+        if (GetTempPathA (MAX_PATH, tempPath) != 0)
+        {
+            char fullPath[MAX_PATH + 64]{};
+            std::snprintf (fullPath, sizeof (fullPath), "%sd2d_present_diagnostic.log", tempPath);
+
+            if (auto* f = std::fopen (fullPath, "a"))
+            {
+                std::fputs (text, f);
+                std::fclose (f);
+            }
+        }
+    }
+
+    // Per-probe state, so the "normal" and "test" probes are tracked (and logged) completely
+    // independently -- one probe's transitions never reset or interfere with the other's.
+    struct Tracker
+    {
+        HRESULT lastHr = S_OK;
+        std::uint32_t countSinceTransition = 0;
+        std::chrono::steady_clock::time_point lastTransitionTime = std::chrono::steady_clock::now();
+        bool first = true;
+    };
+
+    inline void record (const char* label, HRESULT hr, UINT syncInterval, UINT flags, Tracker& tracker) noexcept
+    {
+        ++tracker.countSinceTransition;
+
+        if (! tracker.first && hr == tracker.lastHr)
+            return;
+
+        const auto now = std::chrono::steady_clock::now();
+        const auto heldMs = std::chrono::duration_cast<std::chrono::milliseconds> (now - tracker.lastTransitionTime).count();
+
+        SYSTEMTIME st;
+        GetLocalTime (&st);
+
+        char line[448]{};
+
+        if (tracker.first)
+        {
+            std::snprintf (line, sizeof (line),
+                            "[%02u:%02u:%02u.%03u] D2D_DIAG [%s] start: hr=0x%08lX (%s) syncInterval=%u flags=0x%08X\n",
+                            st.wHour, st.wMinute, st.wSecond, st.wMilliseconds,
+                            label, (unsigned long) hr, decodeHresult (hr), syncInterval, flags);
+            tracker.first = false;
+        }
+        else
+        {
+            std::snprintf (line, sizeof (line),
+                            "[%02u:%02u:%02u.%03u] D2D_DIAG [%s] transition: hr=0x%08lX (%s) held for %u calls (%lld ms) -> hr=0x%08lX (%s) syncInterval=%u flags=0x%08X\n",
+                            st.wHour, st.wMinute, st.wSecond, st.wMilliseconds,
+                            label,
+                            (unsigned long) tracker.lastHr, decodeHresult (tracker.lastHr),
+                            tracker.countSinceTransition, (long long) heldMs,
+                            (unsigned long) hr, decodeHresult (hr),
+                            syncInterval, flags);
+        }
+
+        logLine (line);
+
+        tracker.lastHr = hr;
+        tracker.countSinceTransition = 0;
+        tracker.lastTransitionTime = now;
+    }
+
+    inline void onPresent1Result (HRESULT hr, UINT syncInterval, UINT flags) noexcept
+    {
+        static Tracker tracker;
+        record ("Present1 normal", hr, syncInterval, flags, tracker);
+    }
+
+    inline void onPresent1TestResult (HRESULT hr) noexcept
+    {
+        static Tracker tracker;
+        record ("Present1 test", hr, 0, DXGI_PRESENT_TEST, tracker);
+    }
+}
+// ========================= END DIAGNOSTIC LOGGING ==========================
+
